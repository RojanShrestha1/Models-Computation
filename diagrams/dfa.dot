digraph DFA {
  rankdir=LR;
  node [shape=circle];
  start [shape=point];
  q_accept [shape=doublecircle];
  q_dead [shape=circle, color=red];
  start -> q0;
  q0 -> q_server [label="SERVER"];
  q_server -> q_accept [label="LBRACE"];
  q0 -> q_location [label="LOCATION"];
  q_location -> q_path [label="PATH"];
  q_path -> q_accept [label="LBRACE"];
  q0 -> q_listen [label="LISTEN"];
  q_listen -> q_number [label="NUMBER"];
  q_number -> q_accept [label="SEMICOLON"];
  q0 -> q_action [label="ALLOW/DENY"];
  q_action -> q_target [label="IPV4/ALL"];
  q_target -> q_accept [label="SEMICOLON"];
  q0 -> q_accept [label="RBRACE"];
  q0 -> q_dead [label="other"];
}
